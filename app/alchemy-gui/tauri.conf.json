{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alchemy",
  "identifier": "computer.alchemy.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../alchemy-web/dist",
    "beforeDevCommand": { "script": "vp dev", "cwd": "../alchemy-web" },
    "beforeBuildCommand": { "script": "vp run build", "cwd": "../alchemy-web" }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Alchemy",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:7240 ws://127.0.0.1:7240",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage"],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
